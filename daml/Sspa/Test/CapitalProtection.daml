-- | End-to-end Daml Script scenarios for the four SSPA Capital Protection products. Each scenario
-- originates a note, mints it into the investor's holding, lifecycles the underlying claim tree
-- forward through one or more market events (feeding it price fixings via an `Observation`
-- contract), and then claims + fully settles every `Effect` produced -- asserting the investor's
-- actual CHF holding balance at each step. Expected amounts are computed by hand in the comments so
-- that each assertion is self-documenting.
module Sspa.Test.CapitalProtection where

import DA.Assert ((===))
import DA.Date (Month(..), date)
import DA.Map qualified as Map
import DA.Set qualified as Set
import Daml.Finance.Data.V4.Time.DateClock (dateToDateClockTime)
import Daml.Finance.Interface.Types.Common.V3.Types (HoldingStandard(..), Id(..))
import Daml.Finance.Interface.Types.Date.V3.Calendar (BusinessDayConventionEnum(..))
import Daml.Finance.Interface.Types.Date.V3.RollConvention (PeriodEnum(..))
import Daml.Script
import Sspa.CapitalProtection.Barrier qualified as Barrier
import Sspa.CapitalProtection.Coupon qualified as Coupon
import Sspa.CapitalProtection.Participation qualified as Participation
import Sspa.CapitalProtection.TwinWin qualified as TwinWin
import Sspa.Test.Setup

-- | SSPA 1100 -- Capital Protection Note with Participation.
--
-- Scenario A: the underlying finishes above the strike -> protection + participation.
-- Scenario B: the underlying finishes below the strike -> protection only.
runParticipation : Script ()
runParticipation = script do
  infra@Infra{issuer; investor; publicParty; cashInstrument; holdingFactoryCid; investorNoteAccount}
    <- setupInfra
  let
    issueDate = date 2026 Jan 1
    maturityDate = date 2026 Apr 1
    referenceAssetId = "SSPA1100-UNDERLYING"
    strike = 100.0
    protectionLevel = 1.0
    participationRate = 1.0
    notional = 1000.0
    lastEventTimestamp = dateToDateClockTime issueDate
    observers =
      Map.fromList [("Investor", Set.singleton investor), ("PublicParty", Set.singleton publicParty)]

  -- Scenario A: spot@maturity = 120.0
  --   participation = notional * participationRate * max(0, 120/100 - 1) = 1000 * 0.2   =  200.0
  --   protection    = notional * protectionLevel                                        = 1000.0
  --   expected total CHF credited to investor                                           = 1200.0
  do
    factoryCid <- submit issuer do createCmd Participation.Factory with depository = issuer; issuer
    noteInstrument <- submit issuer do
      exerciseCmd factoryCid Participation.Originate with
        id = Id "SSPA1100-ITM"; description = "Capital Protection Note with Participation (ITM)"
        referenceAssetId; strike; protectionLevel; participationRate; maturityDate
        currency = cashInstrument; notional; observers; holdingStandard = TransferableFungible
        lastEventTimestamp
    noteHoldingCid <- mintHolding holdingFactoryCid noteInstrument investorNoteAccount 1.0 observers

    obsCid <- createObservation issuer referenceAssetId [(maturityDate, 120.0)]
    (_, [effectCid]) <-
      lifecycleInstrument issuer [publicParty] maturityDate noteInstrument [obsCid]

    result <- claimAndSettle infra noteHoldingCid effectCid (Id "settle-1100-itm")
    Some cashCid <- pure result.cashHoldingCid
    total <- sumHoldingAmounts investor [cashCid]
    total === 1200.0

  -- Scenario B: spot@maturity = 90.0 -> participation = 0
  --   expected total CHF credited to investor = 1000.0 (protection only)
  do
    factoryCid <- submit issuer do createCmd Participation.Factory with depository = issuer; issuer
    noteInstrument <- submit issuer do
      exerciseCmd factoryCid Participation.Originate with
        id = Id "SSPA1100-OTM"; description = "Capital Protection Note with Participation (OTM)"
        referenceAssetId; strike; protectionLevel; participationRate; maturityDate
        currency = cashInstrument; notional; observers; holdingStandard = TransferableFungible
        lastEventTimestamp
    noteHoldingCid <- mintHolding holdingFactoryCid noteInstrument investorNoteAccount 1.0 observers

    obsCid <- createObservation issuer referenceAssetId [(maturityDate, 90.0)]
    (_, [effectCid]) <-
      lifecycleInstrument issuer [publicParty] maturityDate noteInstrument [obsCid]

    result <- claimAndSettle infra noteHoldingCid effectCid (Id "settle-1100-otm")
    Some cashCid <- pure result.cashHoldingCid
    total <- sumHoldingAmounts investor [cashCid]
    total === 1000.0

  pure ()

-- | SSPA 1130 -- Capital Protection Note with Barrier.
--
-- Scenario A: the (upper) barrier is never touched, underlying finishes above the strike ->
-- protection + participation.
-- Scenario B: the barrier is touched at an interim date -> participation is knocked out and a fixed
-- rebate is paid instead (at the moment of breach); protection is still paid in full at maturity.
runBarrier : Script ()
runBarrier = script do
  infra@Infra{issuer; investor; publicParty; cashInstrument; holdingFactoryCid; investorNoteAccount}
    <- setupInfra
  let
    issueDate = date 2026 Jan 1
    maturityDate = date 2026 Apr 1
    breachDate = date 2026 Feb 15
    referenceAssetId = "SSPA1130-UNDERLYING"
    strike = 100.0
    barrier = 130.0
    barrierStartDate = issueDate
    rebateRate = 0.05
    protectionLevel = 1.0
    participationRate = 1.0
    notional = 1000.0
    lastEventTimestamp = dateToDateClockTime issueDate
    observers =
      Map.fromList [("Investor", Set.singleton investor), ("PublicParty", Set.singleton publicParty)]

  -- Scenario A: barrier never touched (only checked at maturity, and never fed a breaching fixing).
  --   spot@maturity = 120.0
  --   participation = notional * participationRate * max(0, 120/100 - 1) = 200.0
  --   protection    = notional * protectionLevel                        = 1000.0
  --   expected total CHF credited to investor                          = 1200.0
  do
    factoryCid <- submit issuer do createCmd Barrier.Factory with depository = issuer; issuer
    noteInstrument <- submit issuer do
      exerciseCmd factoryCid Barrier.Originate with
        id = Id "SSPA1130-NOBREACH"
        description = "Capital Protection Note with Barrier (no breach)"
        referenceAssetId; strike; barrier; barrierStartDate; rebateRate; protectionLevel
        participationRate; maturityDate; currency = cashInstrument; notional; observers
        holdingStandard = TransferableFungible; lastEventTimestamp
    noteHoldingCid <- mintHolding holdingFactoryCid noteInstrument investorNoteAccount 1.0 observers

    -- An observation at `barrierStartDate` is required too: it coincides here with the
    -- instrument's inception, which the lifecycle engine processes as a synthetic time-event
    -- checkpoint while fast-forwarding, and evaluating the claim tree's `at barrierStartDate`
    -- node at that checkpoint needs to resolve the barrier condition's `Observe`.
    obsCid <- createObservation issuer referenceAssetId
      [(barrierStartDate, 100.0), (maturityDate, 120.0)]
    (_, [effectCid]) <-
      lifecycleInstrument issuer [publicParty] maturityDate noteInstrument [obsCid]

    result <- claimAndSettle infra noteHoldingCid effectCid (Id "settle-1130-nobreach")
    Some cashCid <- pure result.cashHoldingCid
    total <- sumHoldingAmounts investor [cashCid]
    total === 1200.0

  -- Scenario B: barrier touched at breachDate, spot@breachDate = 135.0 (>= barrier 130.0).
  --   rebate = notional * rebateRate = 1000 * 0.05 = 50.0, paid at the moment of breach
  --   spot@maturity = 110.0 (participation would have been 100.0, but is knocked out -> 0.0)
  --   protection = notional * protectionLevel = 1000.0, paid at maturity regardless
  --   expected CHF credited at breach   = 50.0
  --   expected CHF credited at maturity = 1000.0
  do
    factoryCid <- submit issuer do createCmd Barrier.Factory with depository = issuer; issuer
    noteInstrument0 <- submit issuer do
      exerciseCmd factoryCid Barrier.Originate with
        id = Id "SSPA1130-BREACH"
        description = "Capital Protection Note with Barrier (breach)"
        referenceAssetId; strike; barrier; barrierStartDate; rebateRate; protectionLevel
        participationRate; maturityDate; currency = cashInstrument; notional; observers
        holdingStandard = TransferableFungible; lastEventTimestamp
    noteHoldingCid0 <- mintHolding holdingFactoryCid noteInstrument0 investorNoteAccount 1.0 observers

    obsCid <- createObservation issuer referenceAssetId
      [(barrierStartDate, 100.0), (breachDate, 135.0), (maturityDate, 110.0)]

    (Some noteInstrument1, [breachEffectCid]) <-
      lifecycleInstrument issuer [publicParty] breachDate noteInstrument0 [obsCid]
    breachResult <-
      claimAndSettle infra noteHoldingCid0 breachEffectCid (Id "settle-1130-breach-rebate")
    Some rebateCashCid <- pure breachResult.cashHoldingCid
    Some noteHoldingCid1 <- pure breachResult.noteHoldingCid
    rebateTotal <- sumHoldingAmounts investor [rebateCashCid]
    rebateTotal === 50.0

    (_, [maturityEffectCid]) <-
      lifecycleInstrument issuer [publicParty] maturityDate noteInstrument1 [obsCid]
    maturityResult <-
      claimAndSettle infra noteHoldingCid1 maturityEffectCid (Id "settle-1130-breach-maturity")
    Some maturityCashCid <- pure maturityResult.cashHoldingCid
    maturityTotal <- sumHoldingAmounts investor [maturityCashCid]
    maturityTotal === 1000.0

  pure ()

-- | SSPA 1135 -- Capital Protection Note with Twin Win.
--
-- Scenario A: the (lower) barrier is never touched, underlying finishes below the strike ->
-- protection + downside participation.
-- Scenario B: the barrier is touched at an interim date -> downside participation is knocked out;
-- since the underlying also finishes below the strike, upside participation is 0 too -> protection
-- only.
runTwinWin : Script ()
runTwinWin = script do
  infra@Infra{issuer; investor; publicParty; cashInstrument; holdingFactoryCid; investorNoteAccount}
    <- setupInfra
  let
    issueDate = date 2026 Jan 1
    maturityDate = date 2026 Apr 1
    breachDate = date 2026 Feb 15
    referenceAssetId = "SSPA1135-UNDERLYING"
    strike = 100.0
    barrier = 70.0
    barrierStartDate = issueDate
    protectionLevel = 1.0
    participationRate = 1.0
    notional = 1000.0
    lastEventTimestamp = dateToDateClockTime issueDate
    observers =
      Map.fromList [("Investor", Set.singleton investor), ("PublicParty", Set.singleton publicParty)]

  -- Scenario A: barrier never touched (only checked at maturity, comfortably above 70.0).
  --   spot@maturity = 85.0
  --   upside     = notional * participationRate * max(0, 85/100 - 1)             = 0.0
  --   downside   = notional * participationRate * max(0, (100 - 85) / 100)       = 1000 * 0.15 = 150.0
  --   protection = notional * protectionLevel                                    = 1000.0
  --   expected total CHF credited to investor                                    = 1150.0
  do
    factoryCid <- submit issuer do createCmd TwinWin.Factory with depository = issuer; issuer
    noteInstrument <- submit issuer do
      exerciseCmd factoryCid TwinWin.Originate with
        id = Id "SSPA1135-NOBREACH"; description = "Twin Win Note (no breach)"
        referenceAssetId; strike; barrier; barrierStartDate; protectionLevel; participationRate
        maturityDate; currency = cashInstrument; notional; observers
        holdingStandard = TransferableFungible; lastEventTimestamp
    noteHoldingCid <- mintHolding holdingFactoryCid noteInstrument investorNoteAccount 1.0 observers

    -- An observation at `barrierStartDate` is required too: see the equivalent comment in
    -- runBarrier for why.
    obsCid <- createObservation issuer referenceAssetId
      [(barrierStartDate, 100.0), (maturityDate, 85.0)]
    (_, [effectCid]) <-
      lifecycleInstrument issuer [publicParty] maturityDate noteInstrument [obsCid]

    result <- claimAndSettle infra noteHoldingCid effectCid (Id "settle-1135-nobreach")
    Some cashCid <- pure result.cashHoldingCid
    total <- sumHoldingAmounts investor [cashCid]
    total === 1150.0

  -- Scenario B: barrier touched at breachDate, spot@breachDate = 65.0 (<= barrier 70.0) -> downside
  -- leg knocked out for the rest of the note's life; no cash is produced by the touch event itself.
  --   spot@maturity = 85.0 -> upside = max(0, 85/100 - 1) = 0.0; downside is knocked out = 0.0
  --   protection = notional * protectionLevel = 1000.0
  --   expected total CHF credited to investor = 1000.0 (protection only)
  do
    factoryCid <- submit issuer do createCmd TwinWin.Factory with depository = issuer; issuer
    noteInstrument0 <- submit issuer do
      exerciseCmd factoryCid TwinWin.Originate with
        id = Id "SSPA1135-BREACH"; description = "Twin Win Note (breach)"
        referenceAssetId; strike; barrier; barrierStartDate; protectionLevel; participationRate
        maturityDate; currency = cashInstrument; notional; observers
        holdingStandard = TransferableFungible; lastEventTimestamp
    noteHoldingCid0 <- mintHolding holdingFactoryCid noteInstrument0 investorNoteAccount 1.0 observers

    obsCid <- createObservation issuer referenceAssetId
      [(barrierStartDate, 100.0), (breachDate, 65.0), (maturityDate, 85.0)]

    (Some noteInstrument1, [breachEffectCid]) <-
      lifecycleInstrument issuer [publicParty] breachDate noteInstrument0 [obsCid]
    breachResult <-
      claimAndSettle infra noteHoldingCid0 breachEffectCid (Id "settle-1135-breach-touch")
    -- No cash should be produced purely by the barrier touch itself.
    breachResult.cashHoldingCid === None
    Some noteHoldingCid1 <- pure breachResult.noteHoldingCid

    (_, [maturityEffectCid]) <-
      lifecycleInstrument issuer [publicParty] maturityDate noteInstrument1 [obsCid]
    maturityResult <-
      claimAndSettle infra noteHoldingCid1 maturityEffectCid (Id "settle-1135-breach-maturity")
    Some maturityCashCid <- pure maturityResult.cashHoldingCid
    maturityTotal <- sumHoldingAmounts investor [maturityCashCid]
    maturityTotal === 1000.0

  pure ()

-- | SSPA 1140 -- Capital Protection Note with Coupon.
--
-- A short (3-period, quarterly) schedule with underlying fixings that produce one positive-
-- performance coupon, one negative-performance period (floored at zero, not negative), and a final
-- positive-performance coupon paid together with the capital protection principal at maturity.
runCoupon : Script ()
runCoupon = script do
  infra@Infra{issuer; investor; calendarDataProvider; publicParty; cashInstrument; holdingFactoryCid;
    investorNoteAccount} <- setupInfra
  let
    issueDate = date 2026 Jan 1
    period1End = date 2026 Apr 1 -- also period 2's start
    period2End = date 2026 Jul 1 -- also period 3's start
    period3End = date 2026 Oct 1 -- = terminationDate = maturityDate
    maturityDate = period3End
    referenceAssetId = "SSPA1140-UNDERLYING"
    protectionLevel = 1.0
    couponParticipation = 1.0
    notional = 1000.0
    holidayCalendarIds = ["CHF"]
    lastEventTimestamp = dateToDateClockTime issueDate
    observers =
      Map.fromList [("Investor", Set.singleton investor), ("PublicParty", Set.singleton publicParty)]
    periodicSchedule = createPaymentPeriodicSchedule period1End holidayCalendarIds NoAdjustment M 3
      issueDate maturityDate

  createHolidayCalendar calendarDataProvider "CHF" [issuer, investor, publicParty]

  factoryCid <- submit issuer do createCmd Coupon.Factory with depository = issuer; issuer
  noteInstrument0 <- submit issuer do
    exerciseCmd factoryCid Coupon.Originate with
      id = Id "SSPA1140"; description = "Capital Protection Note with Coupon"; referenceAssetId
      protectionLevel; couponParticipation; periodicSchedule; holidayCalendarIds
      calendarDataProvider; currency = cashInstrument; notional; observers
      holdingStandard = TransferableFungible; lastEventTimestamp
  noteHoldingCid0 <- mintHolding holdingFactoryCid noteInstrument0 investorNoteAccount 1.0 observers

  -- Period 1 [Jan1, Apr1]:  100 -> 110, perf = +10%
  -- Period 2 [Apr1, Jul1]:  110 -> 100, perf = 100/110 - 1 = -9.09%, floored to 0
  -- Period 3 [Jul1, Oct1]:  100 -> 115, perf = +15%
  obsCid <- createObservation issuer referenceAssetId
    [(issueDate, 100.0), (period1End, 110.0), (period2End, 100.0), (period3End, 115.0)]

  -- Period 1: positive performance.
  --   coupon = notional * couponParticipation * (110/100 - 1) = 1000 * 0.10 = 100.0
  (Some noteInstrument1, [effect1]) <-
    lifecycleInstrument issuer [publicParty] period1End noteInstrument0 [obsCid]
  result1 <- claimAndSettle infra noteHoldingCid0 effect1 (Id "settle-1140-period1")
  Some cash1 <- pure result1.cashHoldingCid
  Some noteHoldingCid1 <- pure result1.noteHoldingCid
  total1 <- sumHoldingAmounts investor [cash1]
  total1 === 100.0

  -- Period 2: negative performance -> the floor means the coupon is 0.0, not negative. No cash is
  -- produced, but the note is still versioned forward since this period's claim has resolved.
  (Some noteInstrument2, [effect2]) <-
    lifecycleInstrument issuer [publicParty] period2End noteInstrument1 [obsCid]
  result2 <- claimAndSettle infra noteHoldingCid1 effect2 (Id "settle-1140-period2")
  result2.cashHoldingCid === None
  Some noteHoldingCid2 <- pure result2.noteHoldingCid

  -- Period 3 / maturity: positive performance coupon + capital protection principal, both paid on
  -- the termination date.
  --   coupon3    = notional * couponParticipation * (115/100 - 1) = 1000 * 0.15 = 150.0
  --   protection = notional * protectionLevel                                  = 1000.0
  --   expected total CHF credited to investor on this date                     = 1150.0
  (_, [effect3]) <-
    lifecycleInstrument issuer [publicParty] period3End noteInstrument2 [obsCid]
  result3 <- claimAndSettle infra noteHoldingCid2 effect3 (Id "settle-1140-period3-maturity")
  Some cash3 <- pure result3.cashHoldingCid
  total3 <- sumHoldingAmounts investor [cash3]
  total3 === 1150.0

  pure ()
