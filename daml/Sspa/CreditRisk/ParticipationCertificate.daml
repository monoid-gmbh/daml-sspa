module Sspa.CreditRisk.ParticipationCertificate where

import DA.Date (daysSinceEpochToDate)
import DA.Set (singleton)
import Daml.Finance.Claims.V3.Util.Builders (createCreditEventPaymentClaims)
import Daml.Finance.Data.V4.Time.DateClock (dateToDateClockTime)
import Daml.Finance.Interface.Claims.V4.Claim qualified as Claim (GetClaims(..), I, View(..))
import Daml.Finance.Interface.Claims.V4.Dynamic.Instrument qualified as DynamicInstrument
  (CreateNewVersion(..), I, View(..))
import Daml.Finance.Interface.Claims.V4.Types (EventData)
import Daml.Finance.Interface.Instrument.Base.V4.Instrument qualified as BaseInstrument
  (I, View(..), createReference, disclosureUpdateReference, instrumentKey)
import Daml.Finance.Interface.Types.Common.V3.Types
  (HoldingStandard(..), Id(..), InstrumentKey(..), PartiesMap)
import Daml.Finance.Interface.Util.V3.Disclosure qualified as Disclosure (I, View(..), flattenObservers)
import Daml.Finance.Util.V4.Disclosure (addObserversImpl, removeObserversImpl, setObserversImpl)
import Sspa.CreditRisk.Util (creditEventWindow, untilCreditEvent)
import Sspa.Participation.Util (createTrackerClaim)

-- | SSPA 1430 -- Participation Certificate with additional credit risk.
--
-- Identical in structure to `Sspa.Participation.TrackerCertificate` (SSPA 1300: a plain 1:1
-- tracker), except the tracker payoff is additionally conditional on no credit event of the
-- reference entity having occurred. If a credit event does occur, the holder instead receives a
-- one-off recovery payment of `(1 - recoveryRate) * notional`, forfeiting the tracker payoff
-- entirely.
--
-- Market expectation (per the SSPA Swiss Derivative Map): rising underlying; no credit event of
-- the reference entity.
template Instrument
  with
    depository : Party
      -- ^ The depository of the instrument.
    issuer : Party
      -- ^ The issuer of the instrument.
    id : Id
      -- ^ An identifier of the instrument.
    version : Text
      -- ^ The instrument's version.
    holdingStandard : HoldingStandard
      -- ^ The holding standard for holdings referencing this instrument.
    description : Text
      -- ^ A description of the instrument.
    referenceAssetId : Text
      -- ^ Reference to the underlying's price fixings.
    referenceEntityId : Text
      -- ^ A human-readable identifier of the reference entity.
    defaultProbabilityReferenceId : Text
      -- ^ Reference to an observable that reaches 1.0 the moment the reference entity's credit
      --   event occurs (and remains below 1.0 until then).
    recoveryRateReferenceId : Text
      -- ^ Reference to an observable giving the recovery rate (as a fraction of notional) paid out
      --   if/when the credit event occurs.
    strike : Decimal
      -- ^ The underlying's initial fixing, used to convert its price into a notional-scaled
      --   redemption amount.
    issueDate : Date
      -- ^ The issue date, used only to bound the credit event observation window.
    maturityDate : Date
      -- ^ The maturity date of the certificate.
    currency : InstrumentKey
      -- ^ The settlement currency of the product, e.g. a CHF cash instrument.
    notional : Decimal
      -- ^ The notional of the product, corresponding to one unit of the product at the strike
      --   level.
    observers : PartiesMap
      -- ^ The observers of the instrument.
    lastEventTimestamp : Time
      -- ^ (Market) time of the last recorded lifecycle event. If no event has occurred yet, the
      --   time of creation should be used.
    prevEvents : [EventData]
      -- ^ A list of previous events that have been lifecycled on this instrument so far.
  where
    signatory depository, issuer
    observer Disclosure.flattenObservers observers

    interface instance Claim.I for Instrument where
      view = Claim.View with acquisitionTime = dateToDateClockTime $ daysSinceEpochToDate 0
      getClaims Claim.GetClaims{} = do
        let
          trackerClaim = untilCreditEvent defaultProbabilityReferenceId $
            createTrackerClaim dateToDateClockTime strike referenceAssetId currency maturityDate
              notional
          creditEventClaim = createCreditEventPaymentClaims dateToDateClockTime True notional
            currency defaultProbabilityReferenceId recoveryRateReferenceId
            (creditEventWindow issueDate maturityDate)
        pure [trackerClaim, creditEventClaim]

    interface instance BaseInstrument.I for Instrument where
      view = BaseInstrument.View with
        depository; issuer; id; version; holdingStandard; description
        validAsOf = lastEventTimestamp
      getKey = BaseInstrument.instrumentKey this

    interface instance DynamicInstrument.I for Instrument where
      view = DynamicInstrument.View with lifecycler = issuer; lastEventTimestamp; prevEvents
      createNewVersion DynamicInstrument.CreateNewVersion{version; lastEventTimestamp;
        prevEvents} = do
          cid <- create this with version; lastEventTimestamp; prevEvents
          BaseInstrument.createReference issuer $ toInterfaceContractId cid
          pure $ toInterfaceContractId cid

    interface instance Disclosure.I for Instrument where
      view = Disclosure.View with disclosureControllers = singleton issuer; observers
      setObservers = setObserversImpl @Instrument this $
        Some . BaseInstrument.disclosureUpdateReference $ BaseInstrument.instrumentKey this
      addObservers = addObserversImpl @Instrument this $
        Some . BaseInstrument.disclosureUpdateReference $ BaseInstrument.instrumentKey this
      removeObservers = removeObserversImpl this .
        Some . BaseInstrument.disclosureUpdateReference $ BaseInstrument.instrumentKey this

-- | Factory to originate `Instrument`s and register them for by-key lookup. The by-key `Reference`
-- is required by the daml-finance lifecycling and claiming machinery, which addresses instruments
-- via `InstrumentKey` rather than `ContractId`.
template Factory
  with
    depository : Party
      -- ^ The depository of instruments created through this factory.
    issuer : Party
      -- ^ The issuer of instruments created through this factory.
  where
    signatory depository, issuer

    nonconsuming choice Originate : InstrumentKey
      -- ^ Create a new `Instrument` and its by-key `Reference`.
      with
        id : Id
        description : Text
        referenceAssetId : Text
        referenceEntityId : Text
        defaultProbabilityReferenceId : Text
        recoveryRateReferenceId : Text
        strike : Decimal
        issueDate : Date
        maturityDate : Date
        currency : InstrumentKey
        notional : Decimal
        observers : PartiesMap
        holdingStandard : HoldingStandard
        lastEventTimestamp : Time
      controller depository, issuer
      do
        cid <- create Instrument with
          depository; issuer; id; version = "0"; holdingStandard; description; referenceAssetId
          referenceEntityId; defaultProbabilityReferenceId; recoveryRateReferenceId; strike
          issueDate; maturityDate; currency; notional; observers; lastEventTimestamp
          prevEvents = []
        BaseInstrument.createReference depository $ toInterfaceContractId cid
        pure InstrumentKey with depository; issuer; id; version = "0"; holdingStandard
